{
  "openapi": "3.0.3",
  "info": {
    "title": "FitFlow Auth API",
    "version": "1.0.0",
    "description": "Endpoints públicos de autenticação do FitFlow"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Desenvolvimento local" }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Cadastro de novo usuário",
        "operationId": "register",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "examples": {
                "valid": {
                  "summary": "Cadastro válido",
                  "value": {
                    "name": "João Silva",
                    "email": "joao@email.com",
                    "password": "minhasenha123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário cadastrado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" },
                "examples": {
                  "success": {
                    "value": {
                      "token": "eyJhbGciOiJIUzI1NiJ9...",
                      "userId": 1,
                      "name": "João Silva",
                      "email": "joao@email.com"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos (campo obrigatório ausente, e-mail malformado, senha muito curta)",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" },
                "examples": {
                  "validation_error": {
                    "value": {
                      "type": "about:blank",
                      "title": "Bad Request",
                      "status": 400,
                      "detail": "Validation failed",
                      "instance": "/api/v1/auth/register"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" },
                "examples": {
                  "email_conflict": {
                    "value": {
                      "type": "about:blank",
                      "title": "Conflict",
                      "status": 409,
                      "detail": "E-mail já está em uso",
                      "instance": "/api/v1/auth/register"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login de usuário existente",
        "operationId": "login",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "examples": {
                "valid": {
                  "summary": "Login válido",
                  "value": {
                    "email": "joao@email.com",
                    "password": "minhasenha123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": {
            "description": "Campos obrigatórios ausentes",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas (e-mail não encontrado ou senha incorreta — mensagem genérica por segurança)",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" },
                "examples": {
                  "invalid_credentials": {
                    "value": {
                      "type": "about:blank",
                      "title": "Unauthorized",
                      "status": 401,
                      "detail": "Credenciais inválidas",
                      "instance": "/api/v1/auth/login"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "João Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "joao@email.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 72,
            "writeOnly": true,
            "example": "minhasenha123"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@email.com"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "example": "minhasenha123"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT válido por 24 horas",
            "example": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJqb2FvQGVtYWlsLmNvbSJ9.abc123"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "João Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@email.com"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "description": "RFC 7807 Problem Detail",
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string", "format": "uri-reference" }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Inclua o token retornado pelo /login no header: Authorization: Bearer <token>"
      }
    }
  }
}
